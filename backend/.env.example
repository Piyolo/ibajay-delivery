ENVIRONMENT=development

# Postgres (Neon recommended) — asyncpg driver.
# IMPORTANT: replace this placeholder with your real Neon connection string,
# use the "+asyncpg" scheme, and append "?ssl=require" (Neon requires TLS
# and asyncpg needs it spelled out explicitly in the URL). Example:
#   postgresql+asyncpg://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/fooddelivery?ssl=require

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Resend (email OTP)
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@yourdomain.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging
FCM_SERVICE_ACCOUNT_JSON=

# Google Maps
GOOGLE_MAPS_API_KEY=

# CORS — comma-separated origins in production, e.g. https://app.yourdomain.com
CORS_ORIGINS=["*"]
