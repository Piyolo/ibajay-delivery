{
  "compilerOptions": {
    "target": "ES2020",
    "useUnknownInTemplateMap": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "eslint": {
      "issues": true
    },
    "resolveJsonModule": true
  },
  "include": ["src"]
}